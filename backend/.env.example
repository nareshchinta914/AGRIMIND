# ==============================================================================
# AGRIMIND BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection String (Prisma format)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrimind_db?schema=public"

# JWT Secret Keys
JWT_SECRET="agrimind_jwt_super_secret_access_key_2026_production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="agrimind_jwt_super_secret_refresh_key_2026_production"
JWT_REFRESH_EXPIRES_IN="30d"

# Client Application URL (for CORS)
CLIENT_URL="http://localhost:5173"

# External Weather & AI Services
WEATHER_API_KEY="demo_weather_api_key"
WEATHER_API_BASE_URL="https://api.openweathermap.org/data/2.5"
AI_SERVICE_URL="http://localhost:8000"
